# ==============================================================================
# CAMPUSVOICE &bull; ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String (Exclusively Required)
# Instructions:
# 1. Create a free cluster on MongoDB Atlas (https://cloud.mongodb.com).
# 2. Add a Database User in "Security" -> "Database Access".
# 3. Add your IP or 0.0.0.0/0 in "Security" -> "Network Access".
# 4. Click "Connect" -> "Drivers" -> "Node.js" and copy the URI.
# 5. Replace <username> and <password> with your database user credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campusvoice?retryWrites=true&w=majority
MONGODB_DATABASE=campusvoice

# JWT Secret Key & Token Expiry (replace with a unique secret)
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
JWT_EXPIRE=7d

# Frontend Client URL (for CORS protection)
CLIENT_URL=http://localhost:5173

# Initial Administrator (seeded only if no matching account exists)
ADMIN_NAME=CampusVoice Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-secret-of-at-least-16-characters

# Local demo accounts are opt-in and rejected for Atlas/production
SEED_DEMO_DATA=false

# Optional SMTP Email Configuration (Nodemailer)
# If left blank, email notifications are logged to the console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CampusVoice Grievance Cell <no-reply@college.edu>

# Optional Cloudinary File Storage (fallback to local server/uploads/ directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
