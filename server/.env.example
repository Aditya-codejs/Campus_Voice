# Render sets PORT automatically; use 5000 for local development.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string; set the database name to campusvoice.
MONGO_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/campusvoice?retryWrites=true&w=majority

# Generate a unique, random secret; do not use this placeholder in production.
JWT_SECRET=<at-least-32-random-characters>
JWT_EXPIRE=7d

# Comma-separated browser origins permitted by CORS (origins only, no route paths).
CLIENT_URL=http://localhost:5173,https://<github-user>.github.io

# Full client URL used to build hash-router links in email (GitHub Pages path included).
CLIENT_APP_URL=https://<github-user>.github.io/Campus_Voice

# Optional initial admin bootstrap settings; only used by the seed script.
ADMIN_NAME=CampusVoice Administrator
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<unique-password-of-at-least-16-characters>
SEED_DEMO_DATA=false

# Optional SMTP settings; leave blank to log email previews in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CampusVoice <no-reply@example.com>

# Optional Cloudinary settings; local disk uploads are used when these are unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
